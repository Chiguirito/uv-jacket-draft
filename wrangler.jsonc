// Cloudflare Worker "nosadia": serves public/ as a static site at nosadia.com.
// Cloudflare builds and deploys it on every push to main (npx wrangler deploy).
// The name must match the Worker in the Cloudflare dashboard.
{
  "name": "nosadia",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public"
  },
  // Custom domains nosadia.com and www.nosadia.com are set in the dashboard (Domains tab), not here.
  // The workers.dev test address is off, so the site lives at nosadia.com only.
  "workers_dev": false,
  "preview_urls": false
}
